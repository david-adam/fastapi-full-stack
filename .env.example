# Example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit `.env` — it is
# listed in `.gitignore` and would leak secrets.

# --- Database ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/blog
DATABASE_URL_DIRECT=postgresql://user:password@localhost:5432/blog

# --- Application secrets ---
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Uploads ---
MAX_UPLOAD_SIZE_BYTES=5242880

# --- AWS S3 (storage / upload backend) ---
S3_BUCKET_NAME=your-bucket-name
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=  # only for non-AWS S3-compatible endpoints (LocalStack, MinIO, etc.)

# --- CloudFront delivery (optional) ---
# When set, application-generated URLs for media served from S3 are
# rewritten to this CloudFront distribution. Leave unset to keep the
# legacy direct-S3 URL behavior.
# Example: https://d111111abcdef8.cloudfront.net
# CLOUDFRONT_BASE_URL=

# --- Email ---
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true

# --- Misc ---
POSTS_PER_PAGE=10
RESET_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:8000